# PollPulse configuration. Copy to ".env" and fill in your values:
#     copy .env.example .env        (Windows)
# The real .env is in .gitignore — never commit it.

# ---- Django ----
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Production only (see docs/DEPLOYMENT.md):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://surveys.example.com
# DJANGO_USE_HTTPS=True
# DJANGO_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=31536000
TIME_ZONE=Asia/Kolkata

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=pollpulse
MONGO_TIMEOUT_MS=3000
# JSON-Schema validators applied by "manage.py init_mongo": warn (log only) or error (reject)
MONGO_SCHEMA_ACTION=warn

# ---- Email (password reset) ----
# Default prints emails in the runserver terminal. For real email use SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=app-password
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PollPulse <no-reply@localhost>

# ---- Optional AI (any OpenAI-compatible Chat Completions API) ----
# Leave AI_API_BASE empty to use the built-in templates and rule-based summaries.
# Examples:
#   AI_API_BASE=https://api.openai.com/v1      AI_MODEL=gpt-4o-mini     AI_API_KEY=sk-...
#   AI_API_BASE=http://localhost:11434/v1      AI_MODEL=llama3.1        (Ollama, no key)
AI_API_BASE=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=20

# ---- Optional ----
CONTACT_EMAIL=
# Rate limits for the REST API (DRF format)
# THROTTLE_ANON=120/hour
# THROTTLE_SUBMIT=30/hour
